    {
      "parameters": {
        "jsCode": "const comment = $('Filter New Comments').item.json;\n\nconst prompt = `Analyze this Instagram comment for a retail store in Kazakhstan.\n\nComment: \"${(comment.text || '').replace(/\"/g, \"'\")}\"\n\nRules for each category:\n- POSITIVE: compliments, thanks, love, fire emoji, praise, \"классно\", \"жақсы\", \"өте керемет\", \"nice\", \"😍🔥❤️\", \"прикол\", \"прикольно\", \"отлично\", \"круто\" — NOT simple greetings\n- NEGATIVE: complaints, criticism, \"не интересно\", \"скучно\", \"дорого\", \"плохо\", \"не нравится\", \"жаман\", \"қымбат\", dismissive comments, \"ужас\", \"ужасно\", \"ужаааас\", \"кошмар\", \"отстой\", \"фу\", \"плохо\", any elongated version of negative words\n- NEUTRAL: short unclear messages, \"ок\", \"окей\", single neutral emojis, greetings with no intent like \"привет\", \"хай\", \"салем\"\n- BUY_INTENT: asking price, \"сколько стоит\", \"қанша тұрады\", \"где купить\", \"как заказать\", \"есть в наличии\", \"жеткізу бар ма\", delivery questions, order questions, \"хочу купить\", \"алғым келеді\"\n\n\nReturn ONLY this JSON, no extra text:\n{\n  \"category\": \"POSITIVE\" or \"NEGATIVE\" or \"BUY_INTENT\" or \"NEUTRAL\",\n  \"confidence\": 0.90,\n  \"suggestedReply\": \"short reply in Russian or Kazakh matching the category\",\n  \"reason\": \"one short sentence explaining why\"\n}`;\n\nreturn {\n  comment_id: comment.id,\n  comment_text: comment.text,\n  username: comment.username,\n  timestamp: comment.timestamp,\n  user_ig_id: comment.from?.id || '',\n  post_permalink: comment.post_permalink || '',\n  post_id: comment.post_id || '',\n  body: JSON.stringify({\n    model: \"llama-3.1-8b-instant\",\n    temperature: 0.2,\n    messages: [\n      {\n        role: \"system\",\n        content: \"You are a helpful assistant for a retail store in Kazakhstan. Return ONLY valid JSON, no markdown, no extra text.\"\n      },\n      {\n        role: \"user\",\n        content: prompt\n      }\n    ]\n  })\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2304,
        1520
      ],
      "id": "46bd3ab4-c2f5-4bcf-91f6-5d15f937e992",
      "name": "Build Groq Request"
    },
    {
      "parameters": {
        "jsCode": "const rawContent = $input.item.json?.choices?.[0]?.message?.content || '';\nconst comment = $('Build Groq Request').item.json;\n\nlet parsed;\ntry {\n  const cleaned = rawContent\n    .replace(/```json/gi, '')\n    .replace(/```/gi, '')\n    .trim();\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  parsed = {\n    category: 'NEUTRAL',\n    confidence: 0.5,\n    suggestedReply: 'Rahmet! 😊',\n    reason: 'Could not parse AI response'\n  };\n}\n\nconst validCategories = ['POSITIVE', 'NEGATIVE', 'BUY_INTENT', 'NEUTRAL'];\nconst category = validCategories.includes(parsed.category)\n  ? parsed.category\n  : 'NEUTRAL';\n\nreturn {\n  comment_id: comment.comment_id,\n  comment_text: comment.comment_text,\n  username: comment.username,\n  timestamp: comment.timestamp,\n  user_ig_id: comment.user_ig_id || '',\n  post_permalink: comment.post_permalink || '',\n  post_id: comment.post_id || '',\n  category: category,\n  confidence: Number(parsed.confidence) || 0.5,\n  suggestedReply: parsed.suggestedReply || 'Rahmet! 😊',\n  reason: parsed.reason || ''\n};"
      },
