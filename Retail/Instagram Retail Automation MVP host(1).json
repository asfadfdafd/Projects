      "parameters": {
        "jsCode": "// Stamp each comment with its parent post's permalink and id so we don't have to look it up later inside the loop.\nconst items = $input.all();\nconst posts = $('Split Posts').all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const post = posts[i] ? posts[i].json : {};\n  const comments = (items[i].json.data || []).map(c => ({\n    ...c,\n    post_permalink: post.permalink || '',\n    post_id: post.id || ''\n  }));\n  out.push({\n    json: { data: comments },\n    pairedItem: { item: i }\n  });\n}\nreturn out;"
      },
