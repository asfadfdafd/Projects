[
  {
    "id": "archivai-pg",
    "name": "ArchivAI Postgres",
    "type": "postgres",
    "data": {
      "host": "${POSTGRES_HOST}",
      "port": ${POSTGRES_PORT},
      "database": "${POSTGRES_DB}",
      "user": "${POSTGRES_USER}",
      "password": "${POSTGRES_PASSWORD}",
      "allowUnauthorizedCerts": false,
      "ssl": "disable",
      "sshTunnel": false
    }
  }
]
