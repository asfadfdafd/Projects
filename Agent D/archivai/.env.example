# ---------- Postgres ----------
POSTGRES_USER=archivai
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=archivai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- MinIO (object storage) ----------
MINIO_ROOT_USER=archivai
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=scans
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- n8n ----------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change_me_n8n_key
GENERIC_TIMEZONE=Asia/Almaty
# n8n reaches the AI service and DB by their compose service names:
AI_SERVICE_URL=http://ai-service:8000
# n8n keeps its own state in the same Postgres. Defaults below prevent the two
# failure modes seen on small machines: a starved connection pool (every webhook
# answers 503) and an execution history that grows until the DB crawls.
N8N_DB_POOL_SIZE=8
N8N_EXEC_MAX_AGE_HOURS=72
N8N_EXEC_MAX_COUNT=500
# Hard stop for a single execution (seconds) — a hung model call must not hold
# an execution and its DB connections indefinitely.
N8N_EXEC_TIMEOUT=2400
# How n8n reaches the web app (used to split PDFs pulled by the connector).
WEB_INTERNAL_URL=http://web:3000

# ---------- AI service: model backend ----------
# Stub mode: 1 = deterministic fake OCR/extraction/embeddings/answers (no GPU or
# models needed — validates the whole n8n + Postgres wiring). Set to 0 and run
# `make models` to switch to the real open-source models.
AI_STUB=1

# OCR_BACKEND: qwen_vl | tesseract | surya
OCR_BACKEND=qwen_vl
# EXTRACT_BACKEND: qwen_vl (vision+extract in one pass) | ollama_text (OCR then text LLM)
EXTRACT_BACKEND=qwen_vl

# Ollama / vLLM endpoint that actually serves the open-source models.
#   http://ollama:11434                 → the bundled Ollama container (Linux servers)
#   http://host.docker.internal:11434  → Ollama running natively on the host — the
#     right choice on a Mac: Docker can't use the GPU, native Ollama uses Metal.
#     (Install Ollama, `ollama pull` the three models, skip the ollama container.)
#   http://<server>:11434               → a remote Ollama box (models need ~12GB disk)
LLM_ENDPOINT=http://ollama:11434
VISION_MODEL=qwen2.5vl:7b
TEXT_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3

# Ollama defaults to a 4k context and an unlimited answer length. A multi-page
# transcript overflows that context, and in JSON mode a small model can then keep
# generating until it fills the rest — indistinguishable from a hung request.
# Both limits are set explicitly on every call; raise num_ctx only if RAM allows.
LLM_NUM_CTX=8192
# Cap for structured extraction answers (fields + summary + entities). OCR is
# deliberately uncapped — a dense page legitimately produces a long transcript.
EXTRACT_NUM_PREDICT=1536

# Tesseract languages (fallback OCR)
TESSERACT_LANGS=rus+kaz
# OCR preprocessing for aged scans (all measurable via scripts/ocr_eval.py).
# Defaults below are the measured best on a 1931 typewriter stenogram
# (CER 0.309 auto+binarize → 0.219 with psm6 and binarization OFF).
TESSERACT_PSM=6
# "" = default engine(3) · 1 = LSTM only. No measurable difference on our sample.
TESSERACT_OEM=
# Reject `kaz` pack noise on Russian pages ("тов"→"тоз", "МЕНДЕШЕВ"→"МЕҢДЕШЕВ"):
# a language pass with implausibly SPARSE Kazakh letters loses the best-of-N race.
OCR_SCRIPT_PENALTY=1
OCR_FILTER_INK=1
OCR_DESKEW=1
# Otsu binarization loses detail on faded type — tesseract thresholds better itself.
OCR_BINARIZE=0
# Opt-in LLM proofreading of OCR text (extra model call per page; raw text is
# kept in pages, the corrected one feeds full_text/search).
# MEASURED HARMFUL on qwen2.5:3b (CER 0.202 → 0.565 — small models rewrite rather
# than correct; guards now reject rewrites). Re-benchmark before enabling on 7B+.
OCR_LLM_CORRECT=0

# Seconds the AI service waits for one model call. Raise on slow/CPU-only hosts.
AI_REQUEST_TIMEOUT=600

# ---------- Extraction limits (long documents) ----------
# Longest transcript handed to the extraction model. Overflowing the context window
# does not error — the prompt is cut and the model returns empty fields (a 12-page
# PDF is enough). We clip explicitly: head + tail, where type/sender/date/signature
# live. Raise it together with the model's context window. 0 = no limit.
EXTRACT_MAX_CHARS=12000
# Page images per one-shot vision call. Longer documents are OCR'd page by page and
# the fields are extracted from the transcript (also gives real per-page text).
VISION_ONESHOT_MAX_PAGES=4

# ---------- Chunking for embeddings ----------
# Documents are embedded chunk by chunk (page boundaries first, long pages split
# with an overlap, tiny pages merged). One vector for a whole file makes long
# documents unfindable — search and RAG both score the best chunk.
CHUNK_MAX_CHARS=1800
CHUNK_MIN_CHARS=400
CHUNK_OVERLAP=200
# Ceiling per document: one embedder call per chunk at ingest time.
CHUNK_MAX_COUNT=200

# ---------- PDF ingest ----------
# PDFs are rendered to one image per page (poppler), so the pipeline, the viewer
# and reprocessing treat them exactly like scans. 200 dpi is the sweet spot for
# typewritten pages; raising it mostly costs time.
PDF_DPI=200
# Hard cap per file — pages beyond this are not ingested (the UI reports it).
PDF_MAX_PAGES=100
# Rendered pages are downscaled to this longest side before OCR.
PDF_MAX_SIDE=2000
PDF_JPEG_QUALITY=85
# Digital PDFs carry an exact text layer — use it instead of OCR (no model call).
# Scanned PDFs have none and fall back to OCR automatically.
PDF_TEXT_LAYER=1
# Fewer characters than this on a page is not a text layer (page numbers, stamps).
PDF_TEXT_MIN_CHARS=120
# Some templates (journals, forms) draw an unfilled layer under the real text.
# Poppler's block analysis shreds such pages into fragments; drawing order (-raw)
# keeps the lines whole. Both are extracted and the less shredded one wins.
PDF_TEXT_AUTO_RAW=1
# How much longer the drawing-order lines must be before it wins (1.25 = +25%).
PDF_RAW_MARGIN=1.25

# ---------- Web app ----------
# Server-side: how the web app reaches n8n from inside compose.
N8N_WEBHOOK_BASE=http://n8n:5678/webhook
# Largest single upload (MB). PDFs of a whole case run bigger than one scan.
UPLOAD_MAX_FILE_MB=200
# How long the web app waits for the AI service to render a PDF (ms).
PDF_SPLIT_TIMEOUT_MS=600000
# Auth (Phase 6). 1 = dev convenience: auto-login as the seeded demo admin
# (demo@archivai.local / archivai-demo). Set 0 for real logins/demos —
# then restart web: docker compose up -d --force-recreate web
AUTH_OPTIONAL=1

# ---------- Connectors (Phase 7) ----------
# Bulk-pull source bucket (client "file storage"; local folders: mc mirror ./dir local/import)
CONNECTOR_BUCKET=import
# Where processed-document JSON is pushed (outbox with retries). Defaults to the
# built-in demo sink; point at the client's legacy endpoint in production.
CLIENT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/client-sink
# For `npm run dev` on the host, override endpoints in web/.env.local instead
# (see web/README.md): POSTGRES_HOST=localhost, MINIO_ENDPOINT=http://localhost:9000,
# MINIO_INTERNAL_ENDPOINT=http://minio:9000, N8N_WEBHOOK_BASE=http://localhost:5678/webhook
