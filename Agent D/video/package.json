{
  "name": "archivai-demo-video",
  "version": "1.0.0",
  "private": true,
  "description": "ArchivAI — демонстрационный ролик (Remotion). JI Studio.",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render ArchivAIDemo out/archivai-demo.mp4 --concurrency=50%",
    "render:hq": "remotion render ArchivAIDemo out/archivai-demo-hq.mp4 --crf=16 --concurrency=50%",
    "render:teaser": "remotion render ArchivAITeaser out/archivai-teaser.mp4 --concurrency=50%",
    "cover": "remotion still ArchivAIDemo out/cover.png --frame=90",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
