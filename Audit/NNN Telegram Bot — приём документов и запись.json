    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i=>i.json);\nlet contract='', recon='';\nfor (const r of rows){ if(r.role==='contract') contract=r.doc_text; else if(r.role==='reconciliation') recon=r.doc_text; }\nconst trig = $('Telegram Trigger').first().json;\nreturn [{ json: { contract_text: contract, reconciliation_text: recon, currency: 'USD', property_name: (trig.message.chat.first_name ? trig.message.chat.first_name+' — объект' : 'Объект') } }];"
      },
      "id": "cb4e0597-c5f1-4f12-b85e-373767ffec5f",
      "name": "🧩 Собрать вход для движка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        0
      ],
      "notes": "Готовим contract_text/reconciliation_text/currency для под-воркфлоу."
    },
    {
