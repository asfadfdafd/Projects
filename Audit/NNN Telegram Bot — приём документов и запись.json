      "id": "96a7039f-fb98-4e53-b50a-ba305998203f",
      "name": "🧠 Анализ (движок)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        656,
        0
      ],
      "notes": "Вызывает под-воркфлоу NNN Analysis Engine. ПОСЛЕ ИМПОРТА выберите его в поле Workflow."
    },
    {
      "parameters": {
        "jsCode": "const e=$('🧠 Анализ (движок)').first().json;\nconst leadId=$('💾 Создать лид').first().json.id;\nconst chat=$('Telegram Trigger').first().json.message.chat;\nconst tasks=(e.tasks||[]).map((t,i)=>`${i+1}. [${t.priority}] ${t.title}\\n   ${t.what_to_do}${t.potential_overcharge?`\\n   💰 ${t.potential_overcharge}`:''}`).join('\\n\\n');\nconst text=`✅ Проверка NNN готова\\n\\n${e.summary||''}\\n\\n💰 Итого возможная переплата: ${e.total_potential_overcharge||'—'}\\n\\nЗадачи:\\n${tasks}\\n\\nХотите детальный аудит и помощь с претензией? Запишитесь ниже 👇`;\nconst base='https://cal.com/dauren-as-000-lfklrn/nnn-детальныи-аудит';\nconst booking_url=`${base}?metadata[lead_id]=${leadId}&name=${encodeURIComponent(chat.first_name||'')}`;\nreturn [{ json:{ tg_text:text, chat_id:String(chat.id), booking_url } }];"
      },
      "id": "2da8c97b-d299-4ddf-bf40-9329bcbd4cb7",
      "name": "✍️ Сформировать ответ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "notes": "Текст ответа + ссылка записи с lead_id в metadata. Замените base ('https://cal.com/your-team/nnn-audit') на свой Cal.com."
    },
