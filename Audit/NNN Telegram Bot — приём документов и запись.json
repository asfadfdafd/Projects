    {
      "parameters": {
        "jsCode": "const cnt = $json.cnt ?? 0;\nconst trig = $('Telegram Trigger').first().json;\nconst text = $('📄 Извлечь текст из PDF').first().json.text || '';\nconst role = cnt === 0 ? 'contract' : 'reconciliation';\nreturn [{ json: { chat_id: String(trig.message.chat.id), role, file_name: trig.message.document.file_name || '', doc_text: text, cnt } }];"
      },
      "id": "2aba6f69-3234-4a97-acb3-714e59955637",
